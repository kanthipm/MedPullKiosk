# Copy to .env — all values optional; the app runs fully without any keys.
#
# LLM provider priority: Groq (if key set) -> local Ollama (if reachable and
# the model below is pulled) -> deterministic rules-based fallback.

# Groq (free tier: https://console.groq.com) — fastest option when configured.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama (default: auto-detected at this URL). The model must answer
# without chain-of-thought — qwen3-vl-agent does; plain qwen3-vl does not.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl-agent:latest

# SQLite database location (default shown)
DATABASE_URL=sqlite:///data/recovery.db
