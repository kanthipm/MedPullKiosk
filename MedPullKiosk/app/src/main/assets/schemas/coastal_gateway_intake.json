{
  "form_id": "coastal_gateway_intake",
  "form_name": "Coastal Gateway Health Center — Patient Intake",
  "version": "2.0",
  "ai_instructions": "You are conducting a patient intake at Coastal Gateway Health Center (CGHC). Work through all 4 sections in order: Registration, Health History, HIPAA Consent, General Consents. Ask one question at a time. Follow all skip_if rules. Be warm and concise. Never display ai_note content to the patient — use it only to guide your responses.",

  "sections": [
    {
      "id": "registration",
      "name": "Section 1: Registration",
      "fields": [
        {
          "id": "preferred_language",
          "label": "Preferred Language",
          "type": "radio",
          "required": true,
          "options": ["English", "Español", "Tiếng Việt", "Other"],
          "ai_note": "Ask this FIRST. If 'Other', collect free text and proceed in English."
        },
        {
          "id": "filling_for_self",
          "label": "Filling Out For",
          "type": "radio",
          "required": true,
          "options": ["Myself", "Someone else"],
          "ai_note": "If 'Someone else', switch to guardian mode — reframe all questions to third person."
        },
        {
          "id": "patient_full_name",
          "label": "Patient Full Name (Last, First)",
          "type": "text",
          "required": true
        },
        {
          "id": "date_of_birth",
          "label": "Date of Birth",
          "type": "date",
          "required": true,
          "hint": "MM/DD/YYYY"
        },
        {
          "id": "mailing_address_street",
          "label": "Mailing Address — Street / PO Box",
          "type": "text",
          "required": true
        },
        {
          "id": "mailing_city",
          "label": "Mailing City",
          "type": "text",
          "required": true
        },
        {
          "id": "mailing_state",
          "label": "Mailing State",
          "type": "text",
          "required": true
        },
        {
          "id": "mailing_zip",
          "label": "Mailing Zip Code",
          "type": "text",
          "required": true
        },
        {
          "id": "physical_same_as_mailing",
          "label": "Physical Address Same as Mailing?",
          "type": "radio",
          "required": true,
          "options": ["Yes", "No"]
        },
        {
          "id": "physical_address_street",
          "label": "Physical Address — Street",
          "type": "text",
          "required": false
        },
        {
          "id": "physical_city",
          "label": "Physical City",
          "type": "text",
          "required": false
        },
        {
          "id": "physical_state",
          "label": "Physical State",
          "type": "text",
          "required": false
        },
        {
          "id": "physical_zip",
          "label": "Physical Zip Code",
          "type": "text",
          "required": false
        },
        {
          "id": "cell_phone",
          "label": "Cell Phone Number",
          "type": "text",
          "required": true
        },
        {
          "id": "home_phone",
          "label": "Home Phone Number",
          "type": "text",
          "required": false
        },
        {
          "id": "email",
          "label": "Email Address",
          "type": "text",
          "required": false,
          "ai_note": "Mention: used for appointment reminders and Healow portal access."
        },
        {
          "id": "demographics_framing",
          "label": "Demographics Framing",
          "type": "static_label",
          "required": false,
          "ai_note": "Deliver: 'Now a few questions about identity and background — these help the clinic provide better care. You can skip any of them.'"
        },
        {
          "id": "sex_assigned_at_birth",
          "label": "Sex Assigned at Birth",
          "type": "radio",
          "required": false,
          "options": ["Female", "Male", "Decline to specify"]
        },
        {
          "id": "gender_identity",
          "label": "Gender Identity",
          "type": "radio",
          "required": false,
          "options": ["Female", "Male", "Transgender Female", "Transgender Male", "Other", "Decline to specify"]
        },
        {
          "id": "race",
          "label": "Race (select all that apply)",
          "type": "multi_select",
          "required": false,
          "options": ["White", "African American / Black", "Asian", "American Indian or Alaska Native", "Native Hawaiian", "Other Pacific Islander", "Other", "Decline to specify"]
        },
        {
          "id": "ethnicity",
          "label": "Ethnicity",
          "type": "radio",
          "required": false,
          "options": ["Not Hispanic or Latino", "Hispanic or Latino", "Decline to specify"]
        },
        {
          "id": "marital_status",
          "label": "Marital Status",
          "type": "radio",
          "required": false,
          "options": ["Single", "Married", "Divorced", "Widowed"]
        },
        {
          "id": "emergency_contact_name",
          "label": "Emergency Contact Name",
          "type": "text",
          "required": true
        },
        {
          "id": "emergency_contact_phone",
          "label": "Emergency Contact Phone",
          "type": "text",
          "required": true
        },
        {
          "id": "emergency_contact_relationship",
          "label": "Emergency Contact Relationship",
          "type": "text",
          "required": true
        },
        {
          "id": "has_insurance",
          "label": "Has Health Insurance",
          "type": "radio",
          "required": true,
          "options": ["Yes", "No"]
        },
        {
          "id": "primary_insurance_provider",
          "label": "Primary Insurance Provider",
          "type": "text",
          "required": false
        },
        {
          "id": "primary_insurance_id",
          "label": "Primary Insurance ID Number",
          "type": "text",
          "required": false
        },
        {
          "id": "primary_insurance_group",
          "label": "Primary Insurance Group Number",
          "type": "text",
          "required": false
        },
        {
          "id": "policyholder_is_self",
          "label": "Is the Policyholder the Patient?",
          "type": "radio",
          "required": false,
          "options": ["Yes", "No"]
        },
        {
          "id": "policyholder_name",
          "label": "Policyholder Name",
          "type": "text",
          "required": false
        },
        {
          "id": "policyholder_dob",
          "label": "Policyholder Date of Birth",
          "type": "date",
          "required": false
        },
        {
          "id": "policyholder_relationship",
          "label": "Policyholder Relationship to Patient",
          "type": "text",
          "required": false
        },
        {
          "id": "has_secondary_insurance",
          "label": "Has Secondary Insurance",
          "type": "radio",
          "required": false,
          "options": ["Yes", "No"]
        },
        {
          "id": "secondary_insurance_provider",
          "label": "Secondary Insurance Provider",
          "type": "text",
          "required": false
        },
        {
          "id": "secondary_insurance_id",
          "label": "Secondary Insurance ID Number",
          "type": "text",
          "required": false
        },
        {
          "id": "secondary_insurance_group",
          "label": "Secondary Insurance Group Number",
          "type": "text",
          "required": false
        }
      ]
    },

    {
      "id": "health_history",
      "name": "Section 2: Health History",
      "fields": [
        {
          "id": "medical_conditions",
          "label": "Diagnosed or Treated Conditions (select all that apply)",
          "type": "multi_select",
          "required": false,
          "options": [
            "None",
            "Heart Disease", "Heart Attack", "High Blood Pressure",
            "Asthma / Lung Disease",
            "Stroke", "Seizures / Epilepsy", "Headaches / Migraines", "Sleep Problems / Sleep Apnea",
            "Diabetes", "Thyroid Problems",
            "Hepatitis", "HIV / AIDS",
            "Cancer", "Anemia", "Liver Disease",
            "Back Problems",
            "Other"
          ]
        },
        {
          "id": "other_health_concerns",
          "label": "Other Health Conditions or Concerns",
          "type": "text",
          "required": false
        },
        {
          "id": "family_history_any",
          "label": "Any Family History of Significant Conditions?",
          "type": "radio",
          "required": false,
          "options": ["Yes", "No"]
        },
        {
          "id": "family_history_conditions",
          "label": "Family History — Conditions Present",
          "type": "multi_select",
          "required": false,
          "options": ["Cancer", "Diabetes", "High Blood Pressure", "Thyroid Problems", "Heart Attack", "Stroke", "Mental Illness", "Drug / Alcohol Abuse"]
        },
        {
          "id": "family_history_members",
          "label": "Family History — Affected Members",
          "type": "text",
          "required": false,
          "ai_note": "For each confirmed condition note which members. E.g. 'Cancer: Mother; Diabetes: Father'."
        },
        {
          "id": "mental_health_framing",
          "label": "Mental Health & Lifestyle",
          "type": "static_label",
          "required": false,
          "ai_note": "Deliver: 'The next questions are about mental health and lifestyle. These help your care team support you fully — everything is confidential. You can skip any question.'"
        },
        {
          "id": "mental_health_conditions",
          "label": "Mental Health and Social History (select all that apply)",
          "type": "multi_select",
          "required": false,
          "options": [
            "None",
            "ADHD", "Depression / Anxiety", "OCD", "Mental Illness",
            "Eating Disorder",
            "Drug / Alcohol Abuse", "Housing / Financial Problems", "Family Stressors",
            "Physical / Emotional Abuse"
          ]
        },
        {
          "id": "tobacco_use",
          "label": "Current Tobacco / Nicotine Use",
          "type": "radio",
          "required": false,
          "options": ["Yes", "No"]
        },
        {
          "id": "tobacco_type",
          "label": "Tobacco Type",
          "type": "text",
          "required": false
        },
        {
          "id": "tobacco_frequency",
          "label": "Tobacco Use Frequency",
          "type": "text",
          "required": false
        },
        {
          "id": "alcohol_use",
          "label": "Current Alcohol Use",
          "type": "radio",
          "required": false,
          "options": ["Yes", "No"]
        },
        {
          "id": "alcohol_frequency",
          "label": "Alcohol Use Frequency",
          "type": "radio",
          "required": false,
          "options": ["Daily", "Weekly", "Occasionally"]
        },
        {
          "id": "surgeries_any",
          "label": "Any Prior Surgeries or Hospitalizations?",
          "type": "radio",
          "required": false,
          "options": ["Yes", "No"]
        },
        {
          "id": "surgeries_list",
          "label": "Surgeries / Hospitalizations List",
          "type": "text",
          "required": false
        },
        {
          "id": "medications_any",
          "label": "Currently Taking Medications, Vitamins, or Supplements?",
          "type": "radio",
          "required": false,
          "options": ["Yes", "No"]
        },
        {
          "id": "medications_list",
          "label": "Medications / Vitamins / Supplements",
          "type": "text",
          "required": false,
          "ai_note": "Collect name, dose, and frequency for each."
        },
        {
          "id": "allergies_any",
          "label": "Known Allergies or Drug Intolerances?",
          "type": "radio",
          "required": false,
          "options": ["Yes", "No"]
        },
        {
          "id": "allergies_list",
          "label": "Allergy List",
          "type": "text",
          "required": false,
          "ai_note": "Collect allergen name and reaction type for each."
        },
        {
          "id": "primary_care_provider",
          "label": "Current Primary Care Provider",
          "type": "text",
          "required": false
        },
        {
          "id": "preferred_pharmacy",
          "label": "Preferred Pharmacy",
          "type": "text",
          "required": false
        }
      ]
    },

    {
      "id": "hipaa_consent",
      "name": "Section 3: HIPAA Consent",
      "fields": [
        {
          "id": "hipaa_summary_delivered",
          "label": "HIPAA Plain Language Summary",
          "type": "static_label",
          "required": false,
          "ai_note": "Deliver: 'This clinic may share your health information with insurance companies, labs, and pharmacies to deliver your care. You have the right to request limits and can revoke consent at any time in writing.'"
        },
        {
          "id": "hipaa_consent",
          "label": "HIPAA Consent — Authorize use and sharing of your health information",
          "type": "radio",
          "required": true,
          "options": ["Yes, I consent", "No"]
        },
        {
          "id": "authorized_phi_contacts_any",
          "label": "Authorize Additional People to Receive Your Health Information?",
          "type": "radio",
          "required": false,
          "options": ["Yes", "No"]
        },
        {
          "id": "authorized_phi_contact_1_name",
          "label": "Authorized Contact 1 — Name",
          "type": "text",
          "required": false
        },
        {
          "id": "authorized_phi_contact_1_relationship",
          "label": "Authorized Contact 1 — Relationship",
          "type": "text",
          "required": false
        },
        {
          "id": "authorized_phi_contact_2_name",
          "label": "Authorized Contact 2 — Name",
          "type": "text",
          "required": false
        },
        {
          "id": "authorized_phi_contact_2_relationship",
          "label": "Authorized Contact 2 — Relationship",
          "type": "text",
          "required": false
        },
        {
          "id": "name_confirmation",
          "label": "Name and Address Confirmation",
          "type": "radio",
          "required": true,
          "options": ["Confirmed — everything looks correct", "I need to make a correction"],
          "ai_note": "Pre-populate with name and address from registration. Ask patient to confirm before signature."
        }
      ]
    },

    {
      "id": "general_consents",
      "name": "Section 4: General Consents",
      "fields": [
        {
          "id": "general_consents_summary_delivered",
          "label": "General Consents Overview",
          "type": "static_label",
          "required": false,
          "ai_note": "Deliver: 'The following covers consents for treatment, financial responsibility, e-prescribing, and appointment reminders. Two items need your explicit decision: the Sliding Fee program and GHHC data sharing.'"
        },
        {
          "id": "sliding_fee_acknowledgment",
          "label": "Sliding Fee Discount Program — I understand and acknowledge",
          "type": "radio",
          "required": true,
          "options": ["Yes, I understand", "I have questions"],
          "ai_note": "Explain: 'If you qualify for the Sliding Fee Discount Program, it is the payer of last resort. You are required to report any changes in insurance coverage.'"
        },
        {
          "id": "ghhc_data_sharing",
          "label": "Greater Houston Healthconnect (GHHC) — Authorize electronic sharing of health records",
          "type": "radio",
          "required": true,
          "options": ["Yes, I authorize", "No, I opt out"],
          "ai_note": "Explain: 'CGHC participates in GHHC, which shares your records with labs, pharmacies, and hospitals in the network. You can revoke within 3 days written notice. No impact on treatment.'"
        },
        {
          "id": "photo_consent",
          "label": "Photography Consent for Identity Verification",
          "type": "radio",
          "required": true,
          "options": ["Yes, I consent", "No"]
        },
        {
          "id": "telehealth_notice_acknowledged",
          "label": "Telehealth Limitations Acknowledgment",
          "type": "radio",
          "required": false,
          "options": ["Yes, I understand", "I have questions"],
          "ai_note": "Only for telehealth visits — skip entirely for in-person."
        },
        {
          "id": "final_signature",
          "label": "Signature — All Consents Acknowledged",
          "type": "signature",
          "required": true
        },
        {
          "id": "representative_name",
          "label": "Personal Representative Name (if signing on behalf)",
          "type": "text",
          "required": false
        },
        {
          "id": "representative_relationship",
          "label": "Personal Representative Relationship",
          "type": "text",
          "required": false
        }
      ]
    }
  ]
}
