{
  "form_id": "coastal_gateway_intake",
  "form_name": "Coastal Gateway — Patient Intake",
  "version": "2.0-demo",
  "ai_instructions": "You are conducting a patient intake at Coastal Gateway Health Center. Ask one question at a time. Follow all skip_if rules. Be warm and concise.",

  "sections": [
    {
      "id": "registration",
      "name": "Registration",
      "fields": [
        {
          "id": "patient_full_name",
          "label": "Full Name (Last, First)",
          "type": "text",
          "required": true
        },
        {
          "id": "date_of_birth",
          "label": "Date of Birth",
          "type": "date",
          "required": true,
          "hint": "MM/DD/YYYY"
        },
        {
          "id": "cell_phone",
          "label": "Cell Phone Number",
          "type": "text",
          "required": true
        },
        {
          "id": "email",
          "label": "Email Address",
          "type": "text",
          "required": false
        },
        {
          "id": "has_insurance",
          "label": "Do you have health insurance?",
          "type": "radio",
          "required": true,
          "options": ["Yes", "No"]
        },
        {
          "id": "primary_insurance_provider",
          "label": "Insurance Provider",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "id": "health_history",
      "name": "Health History",
      "fields": [
        {
          "id": "medical_conditions",
          "label": "Any diagnosed conditions? (select all that apply)",
          "type": "multi_select",
          "required": false,
          "options": [
            "None",
            "Diabetes", "High Blood Pressure", "Heart Disease",
            "Asthma", "Cancer", "Depression / Anxiety", "Other"
          ]
        },
        {
          "id": "allergies_any",
          "label": "Do you have any known allergies?",
          "type": "radio",
          "required": false,
          "options": ["Yes", "No"]
        },
        {
          "id": "allergies_list",
          "label": "Please list your allergies and reactions",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "id": "consent",
      "name": "Consent & Signature",
      "fields": [
        {
          "id": "hipaa_consent",
          "label": "HIPAA Consent — authorize use of your health information for treatment and billing",
          "type": "radio",
          "required": true,
          "options": ["Yes, I consent", "No"]
        },
        {
          "id": "final_signature",
          "label": "Signature",
          "type": "signature",
          "required": true
        }
      ]
    }
  ]
}
